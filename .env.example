# Copy this file to .env.local and fill in your key. .env.local is git-ignored.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Required for OpenAI voice and microphone. Without it the app falls back to the
# browser's built-in speech (Apple voices on Safari/iPhone, Google on Chrome).
OPENAI_API_KEY=

# Optional overrides (defaults shown).
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
